setcpm(30)

//Like a virgin!
let transpose = register('transpose', (pat) => pat.scale('F:major').scaleTranspose("<0 -1 -1.5 -1>"))

const first = stack (
  sound("[bd hh](2,4)*4"),
  note("F#3 Eb3 Db3 F#3 F#3 Eb3 Db3 Eb3").sound("sin").gain(1.5),
)
const second = stack(
  first,
  note("[~ F#6] [~ F#6] ~ ~ ,[~ A#6] [~ A#6] ~ ~ , [~ C#6] [~ C#6] ~ ~ ").release(0.01).sound("gm_lead_8_bass_lead").lpf(2000)
).mask("<0 0 1 1>")

$: stack(first, second)